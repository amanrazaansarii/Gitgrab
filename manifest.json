{
  "manifest_version": 3,
  "name": "GitGrab - GitHub Folder & Repo Downloader",
  "version": "1.0.0",
  "description": "Download any GitHub folder, directory, file, or full repository as a ZIP directly in a single click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "*://github.com/*",
    "*://api.github.com/*",
    "*://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": [
        "src/lib/jszip.min.js",
        "src/utils/url-parser.js",
        "src/utils/storage.js",
        "src/lib/github-api.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "GitGrab Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
